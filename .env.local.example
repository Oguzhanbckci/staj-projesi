# ==============================================================================
# Ortam değişkenleri şablonu
# ==============================================================================
# Yerel geliştirme için: bu dosyayı ".env.local" adıyla kopyalayın, aşağıdaki
# değerleri doldurun. ".env.local" .gitignore'da — asla commit'lenmez.
#
# Yeni bir müşteri kurulumu için: aynı değişkenleri (E2E_* hariç, aşağıda
# açıklanıyor) Vercel Dashboard -> Project Settings -> Environment Variables'a
# girin. Adım adım nereden alınacağı: docs/KURULUM.md.
# ==============================================================================

# --- Supabase — proje bağlantısı ---------------------------------------------

# Supabase proje URL'i.
# Nereden alınır: Supabase Dashboard -> ilgili proje -> Project Settings ->
# Data API -> "Project URL". Sondaki /rest/v1/ yolu varsa SİLİN — bu kütüphane
# sadece kök adresi bekler, /rest/v1/'i kendisi otomatik ekler.
# Gizli DEĞİL — tarayıcıya gönderilir (NEXT_PUBLIC_ öneki bu yüzden var).
NEXT_PUBLIC_SUPABASE_URL=

# Service role anahtarı — RLS'İ (Row Level Security) BYPASS EDER, veritabanına
# sınırsız erişim verir. SADECE sunucu tarafı kodda kullanılır
# (lib/supabase/server.ts), tarayıcıya ASLA gönderilmez — bu yüzden
# NEXT_PUBLIC_ öneki YOK, bu bilinçli ve değiştirilmemeli.
# Nereden alınır: Supabase Dashboard -> ilgili proje -> Project Settings ->
# Configuration -> API Keys -> "service_role" (secret) — yanında "Reveal"
# yazan, gizli tutulması gereken anahtar.
# Bu anahtar sızarsa: Supabase Dashboard'dan HEMEN yenileyin (bkz.
# docs/KURULUM.md "Bakım ve Yedekleme" — anahtar yenileme).
SUPABASE_SERVICE_ROLE_KEY=

# Anon/public anahtarı — RLS'e TABİDİR (service role'ün aksine bypass etmez),
# tarayıcıya gönderilmesi güvenlidir. Panel auth'un (Supabase Auth oturum
# çerezleri) ve panel içi sorguların çalışması için gerekli.
# Nereden alınır: Aynı ekran (API Keys) -> "anon" / "public".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Tenant çözümleme ---------------------------------------------------------

# Bu Next.js kurulumunun HANGİ müşteriyi (tenant) göstereceğini belirler —
# Host header'a göre otomatik tenant çözümlemesi henüz yok (bkz.
# docs/DURUM.md açık madde), bu yüzden şimdilik tek bir sabit değer.
# DEĞERİ: supabase/setup/seed-template.sql çalıştırılırken kullanılan
# __TENANT_DOMAIN__ değeriyle BİREBİR AYNI olmalı — aksi halde site "aktif
# tenant bulunamadı" diyerek boş görünür (hata vermez, sessizce boş kalır,
# en sık yapılan kurulum hatalarından biri — bkz. docs/KURULUM.md "Sık
# Yapılan Hatalar").
# Boş bırakılırsa (yerel geliştirme gibi) "akmeinsaat.com.tr" demo
# tenant'ına düşer (lib/supabase/queries.ts).
ACTIVE_TENANT_DOMAIN=

# Sitenin GERÇEK yayın adresi — sitemap.xml, robots.txt, paylaşım
# görseli ve yapısal veride (JSON-LD) mutlak URL üretmek için kullanılır
# (bkz. lib/seo/getSiteUrl.ts). ACTIVE_TENANT_DOMAIN'DEN FARKLI bir
# kavram: o "hangi tenant'ın verisi gösterilsin" sorusuna cevap verir,
# bu "site şu an gerçekte hangi adresten erişiliyor" sorusuna.
# HER Vercel deploy'unda (özel alan adı olsun ya da olmasın, ".vercel.app"
# adresi dahil) BUNU MUTLAKA AYARLAYIN — Vercel Dashboard -> Project
# Settings -> Environment Variables. Gerçek adresinizi ("Domains"
# sekmesinde görünen, sonunda / OLMADAN, ör. https://proje-adi.vercel.app
# ya da https://akmeinsaat.com.tr) buraya yazın.
#
# 2026-08-17'de GERÇEKTEN yaşandı: bu boş bırakılıp otomatik Vercel
# değişkenlerine (VERCEL_URL) güvenilince, sitemap/robots.txt YİNE
# yanlış (ama BAŞKA bir yanlış) bir adrese işaret etti — VERCEL_URL,
# sizin gördüğünüz kalıcı adres DEĞİL, o TEK deploy'a özel, her deploy'da
# DEĞİŞEN bir hash'li adres veriyor (bkz. lib/seo/getSiteUrl.ts,
# docs/KARAR-GUNLUGU.md). Bu yüzden otomatik yedeklere güvenmeyin, her
# zaman elle ayarlayın.
#
# Yerel geliştirmede: boş bırakılırsa ACTIVE_TENANT_DOMAIN'e düşer (sorun
# değil, yerelde zaten aynı adresten çalışıyorsunuz).
NEXT_PUBLIC_SITE_URL=

# --- E-posta bildirimi (iletişim formu) ---------------------------------------

# Resend API anahtarı — iletişim formuna gelen her mesajda
# `tenants.contact_recipient_email` adresine bildirim e-postası göndermek
# için kullanılır (bkz. docs/KARAR-GUNLUGU.md, 2026-08-18 dokuzuncu oturum).
# Nereden alınır: resend.com/api-keys (ücretsiz hesap, kart bilgisi
# gerekmez, ayda 3.000/günde 100 e-posta sınırı var).
# BOŞ BIRAKILIRSA: iletişim formu YİNE ÇALIŞIR, mesaj yine contact_messages'a
# kaydedilir ve panelde görünür — sadece e-posta bildirimi sessizce
# gönderilmez (bkz. lib/email/resend.ts). Yani bu değişken OPSİYONELDİR.
RESEND_API_KEY=

# Bildirim e-postasının "kimden" göründüğü adres. Boş bırakılırsa
# "onboarding@resend.dev" kullanılır — bu, Resend'in domain doğrulaması
# GEREKTİRMEYEN, hemen çalışan test/paylaşım adresidir (bir müşteri
# kurulumunda kendi domain'inizi Resend'de doğrularsanız buraya
# "bildirim@sizin-domain.com" gibi bir adres yazabilirsiniz).
CONTACT_NOTIFICATION_FROM_EMAIL=

# --- Sadece geliştirme/test — üretim (müşteri) deploy'unda GEREKMEZ ---------

# Playwright uçtan uca "admin kritik akışı" testinin giriş yaptığı gerçek
# panel hesabı — kodda ASLA yazılı olmayacak (bkz. e2e/admin-service-flow.spec.ts).
# Bu değişkenler boşsa o test otomatik atlanır (skip), diğer testler etkilenmez.
# Bir müşteri kurulumunu Vercel'e deploy ederken bu ikisini EKLEMEYİN.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# scripts/test-rls.mjs (RLS politikalarını anon/authenticated rolleriyle
# karşılaştırmalı test eden doğrulama betiği) bu İKİ AYRI İSMİ bekliyor —
# E2E_ADMIN_* ile AYNI hesap, farklı değişken adı. Şablonda eksikti,
# 2026-08-19'daki sıfırdan kurulumda fark edildi (bkz. docs/KARAR-GUNLUGU.md).
# Bunlar da sadece yerel test içindir, üretim deploy'una EKLENMEZ.
TEST_AUTH_EMAIL=
TEST_AUTH_PASSWORD=
