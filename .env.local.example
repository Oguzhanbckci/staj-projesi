# Supabase proje URL'i — dashboard → Integrations → Data API → Project URL.
# Sondaki /rest/v1/ yolunu SİL — @supabase/supabase-js sadece kök adresi
# bekler, /rest/v1/ kütüphane tarafından otomatik eklenir.
NEXT_PUBLIC_SUPABASE_URL=

# Service role key — dashboard → Configuration → API Keys → service_role
# (secret). RLS'i bypass eder, yalnızca sunucu tarafında kullanılır.
# Tarayıcıya asla gönderilmez (NEXT_PUBLIC_ öneki YOK, bu bilinçli).
SUPABASE_SERVICE_ROLE_KEY=

# Anon/public key — dashboard → Configuration → API Keys → anon/public.
# RLS'e tabidir (service_role gibi bypass etmez), tarayıcıya gönderilmesi
# güvenlidir. Panel auth (Supabase Auth) ve RLS testleri için kullanılır.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
