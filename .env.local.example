# ==============================================================================
# Ortam değişkenleri şablonu
# ==============================================================================
# Yerel geliştirme için: bu dosyayı ".env.local" adıyla kopyalayın, aşağıdaki
# değerleri doldurun. ".env.local" .gitignore'da — asla commit'lenmez.
#
# Yeni bir müşteri kurulumu için: aynı değişkenleri (E2E_* hariç, aşağıda
# açıklanıyor) Vercel Dashboard -> Project Settings -> Environment Variables'a
# girin. Adım adım nereden alınacağı: docs/KURULUM.md.
# ==============================================================================

# --- Supabase — proje bağlantısı ---------------------------------------------

# Supabase proje URL'i.
# Nereden alınır: Supabase Dashboard -> ilgili proje -> Project Settings ->
# Data API -> "Project URL". Sondaki /rest/v1/ yolu varsa SİLİN — bu kütüphane
# sadece kök adresi bekler, /rest/v1/'i kendisi otomatik ekler.
# Gizli DEĞİL — tarayıcıya gönderilir (NEXT_PUBLIC_ öneki bu yüzden var).
NEXT_PUBLIC_SUPABASE_URL=

# Service role anahtarı — RLS'İ (Row Level Security) BYPASS EDER, veritabanına
# sınırsız erişim verir. SADECE sunucu tarafı kodda kullanılır
# (lib/supabase/server.ts), tarayıcıya ASLA gönderilmez — bu yüzden
# NEXT_PUBLIC_ öneki YOK, bu bilinçli ve değiştirilmemeli.
# Nereden alınır: Supabase Dashboard -> ilgili proje -> Project Settings ->
# Configuration -> API Keys -> "service_role" (secret) — yanında "Reveal"
# yazan, gizli tutulması gereken anahtar.
# Bu anahtar sızarsa: Supabase Dashboard'dan HEMEN yenileyin (bkz.
# docs/KURULUM.md "Bakım ve Yedekleme" — anahtar yenileme).
SUPABASE_SERVICE_ROLE_KEY=

# Anon/public anahtarı — RLS'e TABİDİR (service role'ün aksine bypass etmez),
# tarayıcıya gönderilmesi güvenlidir. Panel auth'un (Supabase Auth oturum
# çerezleri) ve panel içi sorguların çalışması için gerekli.
# Nereden alınır: Aynı ekran (API Keys) -> "anon" / "public".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Tenant çözümleme ---------------------------------------------------------

# Bu Next.js kurulumunun HANGİ müşteriyi (tenant) göstereceğini belirler —
# Host header'a göre otomatik tenant çözümlemesi henüz yok (bkz.
# docs/DURUM.md açık madde), bu yüzden şimdilik tek bir sabit değer.
# DEĞERİ: supabase/setup/seed-template.sql çalıştırılırken kullanılan
# __TENANT_DOMAIN__ değeriyle BİREBİR AYNI olmalı — aksi halde site "aktif
# tenant bulunamadı" diyerek boş görünür (hata vermez, sessizce boş kalır,
# en sık yapılan kurulum hatalarından biri — bkz. docs/KURULUM.md "Sık
# Yapılan Hatalar").
# Boş bırakılırsa (yerel geliştirme gibi) "akmeinsaat.com.tr" demo
# tenant'ına düşer (lib/supabase/queries.ts).
ACTIVE_TENANT_DOMAIN=

# --- Sadece geliştirme/test — üretim (müşteri) deploy'unda GEREKMEZ ---------

# Playwright uçtan uca "admin kritik akışı" testinin giriş yaptığı gerçek
# panel hesabı — kodda ASLA yazılı olmayacak (bkz. e2e/admin-service-flow.spec.ts).
# Bu değişkenler boşsa o test otomatik atlanır (skip), diğer testler etkilenmez.
# Bir müşteri kurulumunu Vercel'e deploy ederken bu ikisini EKLEMEYİN.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
